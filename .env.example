# Copy to .env and fill in. Local dev values come from `supabase start` output;
# production values from the Supabase project dashboard (Settings → API).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# First admin of /moderate/ — granted by `npm run bootstrap-admin` (needs the
# service-role key below; never prefix these with VITE_).
FIRST_ADMIN_EMAIL=owner@example.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Show the "Publish now" button in Settings (requires the publish-site Edge
# Function and a deploy hook, see README).
# VITE_ENABLE_PUBLISH=true
